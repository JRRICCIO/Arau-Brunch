---
pagination:
  data: languages
  size: 1
  alias: lng
permalink: "/{{ lng.dir }}gracias.html"
pageKey: "gracias"
---
{#- Página de agradecimiento post-reserva. Una versión por idioma. La reserva
    (GoHighLevel) redirige a la que corresponda según el idioma. -#}
{%- set T = {
  es: {
    title: "¡Gracias por tu reserva! · ARAU",
    eyebrow: "Reserva pre-confirmada",
    h1: "¡Muchas gracias!",
    lead: "Esta es una pre-reserva, así que nos pondremos en contacto contigo para confirmarla.",
    q: "¿Ya sabes qué vas a pedir?",
    cta: "Ver menú completo",
    badge: "Bebida de regalo con tu reserva",
    llegarEyebrow: "Nos vemos pronto",
    llegarTitle: "Cómo llegar",
    llegarText: "Estamos en pleno Eixample, a un paso del passeig de Gràcia.",
    llegarBtn: "Cómo llegar con Google Maps",
    back: "Volver a la web"
  },
  en: {
    title: "Thank you for your booking · ARAU",
    eyebrow: "Pre-confirmed reservation",
    h1: "Thank you very much!",
    lead: "This is a pre-reservation, so we'll get in touch with you to confirm it.",
    q: "Already know what you'll order?",
    cta: "View full menu",
    badge: "A free drink with your booking",
    llegarEyebrow: "See you soon",
    llegarTitle: "How to get here",
    llegarText: "We're in the heart of the Eixample, steps from passeig de Gràcia.",
    llegarBtn: "Get directions on Google Maps",
    back: "Back to the website"
  },
  fr: {
    title: "Merci pour votre réservation · ARAU",
    eyebrow: "Réservation pré-confirmée",
    h1: "Merci beaucoup !",
    lead: "Ceci est une pré-réservation ; nous vous contacterons pour la confirmer.",
    q: "Vous savez déjà ce que vous allez commander ?",
    cta: "Voir la carte complète",
    badge: "Une boisson offerte avec votre réservation",
    llegarEyebrow: "À très bientôt",
    llegarTitle: "Comment venir",
    llegarText: "Nous sommes au cœur de l'Eixample, à deux pas du passeig de Gràcia.",
    llegarBtn: "Itinéraire sur Google Maps",
    back: "Retour au site"
  },
  ca: {
    title: "Gràcies per la teva reserva · ARAU",
    eyebrow: "Reserva pre-confirmada",
    h1: "Moltes gràcies!",
    lead: "Aquesta és una pre-reserva, així que ens posarem en contacte amb tu per confirmar-la.",
    q: "Ja saps què demanaràs?",
    cta: "Veure la carta completa",
    badge: "Una beguda de regal amb la teva reserva",
    llegarEyebrow: "Ens veiem aviat",
    llegarTitle: "Com arribar",
    llegarText: "Som al cor de l'Eixample, a tocar del passeig de Gràcia.",
    llegarBtn: "Com arribar amb Google Maps",
    back: "Tornar al web"
  }
} -%}
{%- set t = T[lng.code] -%}
{%- set mapsUrl = "https://www.google.com/maps/dir/?api=1&destination=ARAU%20brunch%20Carrer%20de%20Proven%C3%A7a%20322%20Barcelona" -%}
<!DOCTYPE html>
<html lang="{{ lng.htmlLang }}" class="no-js">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#8c3724" />
  <meta name="robots" content="noindex, follow" />

  <title>{{ t.title }}</title>
  <meta name="description" content="{{ t.lead }}" />

  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/lato-900.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/lato-400.woff2" crossorigin />
  <link rel="stylesheet" href="/styles.css" />
  <script>document.documentElement.classList.remove('no-js');document.documentElement.classList.add('js');</script>

  <style>
    /* Usa los tokens de styles.css (--terra, --cream, etc). Página autocontenida. */
    body { margin: 0; }
    .ty {
      min-height: 100svh;
      display: grid;
      place-items: center;
      padding: clamp(28px, 6vw, 72px) clamp(20px, 5vw, 56px);
      color: var(--on-dark);
      background:
        radial-gradient(130% 120% at 82% -10%, var(--terra) 0%, var(--terra-deep) 62%, #782e1e 100%);
      font-family: "Lato", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    }
    .ty__inner {
      width: min(1060px, 100%);
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(32px, 5vw, 60px);
      align-items: center;
    }
    @media (min-width: 900px) {
      .ty__inner { grid-template-columns: 1.02fr 0.98fr; }
    }
    .ty__word {
      display: inline-block;
      width: clamp(118px, 16vw, 150px);
      color: var(--on-dark);
      opacity: .95;
      margin-bottom: clamp(20px, 3vw, 30px);
    }
    .ty__word .arau-word { width: 100%; height: auto; display: block; }
    .ty__word small {
      display: block;
      font-size: .58rem;
      letter-spacing: .42em;
      text-transform: uppercase;
      color: var(--on-dark-soft);
      margin-top: 6px;
      padding-left: 3px;
    }
    .ty__eyebrow {
      display: inline-block;
      font-weight: 900;
      font-size: .78rem;
      letter-spacing: .2em;
      text-transform: uppercase;
      color: var(--gold-text);
      margin: 0 0 .5rem;
    }
    .ty__eyebrow::before,
    .ty__eyebrow::after { content: "🎉"; margin: 0 .5em; }
    .ty__title {
      font-weight: 900;
      font-size: clamp(2.7rem, 7.5vw, 4.4rem);
      line-height: 1.02;
      letter-spacing: -.01em;
      margin: 0 0 .5rem;
      text-wrap: balance;
    }
    .ty__lead {
      font-size: clamp(1.02rem, 1.7vw, 1.18rem);
      line-height: 1.55;
      max-width: 40ch;
      color: var(--on-dark);
      margin: 0 0 1.4rem;
    }
    .ty__q {
      font-weight: 900;
      font-size: clamp(1.1rem, 2vw, 1.3rem);
      margin: 0 0 1.1rem;
      color: var(--on-dark);
    }
    .ty .btn--cream {
      background: var(--cream-card);
      color: var(--terra-deep);
      box-shadow: 0 14px 34px -18px rgba(0,0,0,.55);
    }
    .ty .btn--cream:hover { background: #fff; }
    .ty__llegar {
      margin-top: clamp(26px, 3.5vw, 40px);
      padding-top: clamp(22px, 3vw, 30px);
      border-top: 1px solid rgba(239, 231, 213, .22);
    }
    .ty__llegar-eyebrow {
      font-weight: 900;
      font-size: .72rem;
      letter-spacing: .2em;
      text-transform: uppercase;
      color: var(--on-dark-soft);
      margin: 0 0 .35rem;
    }
    .ty__llegar-title {
      font-weight: 900;
      font-size: clamp(1.4rem, 3vw, 1.9rem);
      margin: 0 0 .3rem;
    }
    .ty__addr {
      font-size: 1.02rem;
      line-height: 1.5;
      color: var(--on-dark);
      margin: 0 0 1rem;
    }
    .ty__addr strong { display: block; font-size: 1.08rem; }
    .ty__addr span { color: var(--on-dark-soft); }
    .ty__llegar-btn {
      display: inline-flex;
      align-items: center;
      gap: .55rem;
      padding: .8rem 1.35rem;
      border-radius: 999px;
      border: 1.5px solid rgba(239, 231, 213, .5);
      color: var(--on-dark);
      font-weight: 900;
      font-size: .96rem;
      text-decoration: none;
      transition: background .18s ease, border-color .18s ease, transform .18s ease;
    }
    .ty__llegar-btn:hover {
      background: rgba(239, 231, 213, .12);
      border-color: rgba(239, 231, 213, .8);
      transform: translateY(-1px);
    }
    .ty__llegar-btn svg { flex: 0 0 auto; }
    /* Columna visual */
    .ty__aside { position: relative; }
    .ty__frame {
      position: relative;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 40px 80px -40px rgba(0,0,0,.7);
      border: 8px solid var(--cream-card);
      aspect-ratio: 4 / 5;
    }
    .ty__frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .ty__drink {
      position: absolute;
      right: clamp(-6px, -1vw, -14px);
      bottom: clamp(-10px, -1.4vw, -18px);
      width: clamp(140px, 22vw, 186px);
      aspect-ratio: 1;
      border-radius: 50%;
      background: var(--cream-card);
      color: var(--terra-deep);
      display: grid;
      place-content: center;
      text-align: center;
      padding: 1rem;
      box-shadow: 0 22px 44px -20px rgba(0,0,0,.6);
      transform: rotate(-6deg);
    }
    .ty__drink b { font-size: 1.5rem; line-height: 1; display: block; }
    .ty__drink-big { font-weight: 900; font-size: clamp(1.05rem, 2.4vw, 1.35rem); line-height: 1.05; margin-top: .3rem; }
    .ty__drink-small { font-size: .62rem; letter-spacing: .16em; text-transform: uppercase; margin-top: .35rem; color: var(--terra); }
    .ty__back {
      display: inline-block;
      margin-top: clamp(20px, 3vw, 28px);
      color: var(--on-dark-soft);
      font-size: .92rem;
      text-decoration: none;
      border-bottom: 1px solid rgba(202, 187, 159, .4);
      padding-bottom: 2px;
    }
    .ty__back:hover { color: var(--on-dark); }
    @media (max-width: 899px) {
      .ty__aside { order: -1; max-width: 380px; margin: 0 auto; width: 100%; }
      .ty__drink { right: 6px; bottom: -14px; width: clamp(128px, 34vw, 150px); transform: rotate(-6deg); }
      .ty__drink-big { font-size: 1rem; }
    }
  </style>
</head>
<body>
  <main class="ty">
    <div class="ty__inner">
      <section class="ty__copy">
        <span class="ty__word" aria-label="ARAU Grilled Brunch">
          {% include "arau-word.njk" %}
          <small>Grilled Brunch</small>
        </span>

        <p class="ty__eyebrow">{{ t.eyebrow }}</p>
        <h1 class="ty__title">{{ t.h1 }}</h1>
        <p class="ty__lead">{{ t.lead }}</p>
        <p class="ty__q">{{ t.q }}</p>
        <a class="btn btn--lg btn--cream" href="/{{ lng.dir }}carta.html">{{ t.cta }}</a>

        <div class="ty__llegar">
          <p class="ty__llegar-eyebrow">{{ t.llegarEyebrow }}</p>
          <h2 class="ty__llegar-title">{{ t.llegarTitle }}</h2>
          <p class="ty__addr">
            <strong>Carrer de Provença, 322</strong>
            <span>08037 Barcelona · Eixample</span>
          </p>
          <p class="ty__addr" style="max-width:38ch;margin-bottom:1.1rem">{{ t.llegarText }}</p>
          <a class="ty__llegar-btn" href="{{ mapsUrl }}" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z" fill="currentColor"/></svg>
            {{ t.llegarBtn }}
          </a>
        </div>

        <a class="ty__back" href="/{{ lng.dir }}">{{ t.back }} ↗</a>
      </section>

      <aside class="ty__aside">
        <div class="ty__frame">
          <img src="/img/spread.jpg" alt="ARAU Grilled Brunch" loading="eager" />
        </div>
        <div class="ty__drink" role="img" aria-label="{{ t.badge }}">
          <b>🍹</b>
          <span class="ty__drink-big">{{ t.badge }}</span>
        </div>
      </aside>
    </div>
  </main>
</body>
</html>
