  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { margin: 0; background: var(--cream); color: var(--ink); font-family: "Lato", system-ui, sans-serif; }
    .wrap { max-width: 940px; margin: 0 auto; padding: clamp(38px, 7vw, 76px) clamp(20px, 5vw, 40px) clamp(50px, 8vw, 90px); }
    .kick { font-weight: 900; font-size: .74rem; letter-spacing: .2em; text-transform: uppercase; color: var(--terra-text); margin: 0 0 .6rem; }
    h1 { font-weight: 900; font-size: clamp(2rem, 5.5vw, 3rem); line-height: 1.03; letter-spacing: -.01em; margin: 0 0 .6rem; text-wrap: balance; }
    .sub { color: var(--ink-soft); font-size: 1.06rem; line-height: 1.55; max-width: 52ch; margin: 0 0 clamp(28px, 4vw, 42px); }
    .grid { display: grid; grid-template-columns: 1fr; gap: clamp(16px, 2.4vw, 22px); }
    @media (min-width: 620px) { .grid { grid-template-columns: 1fr 1fr; } }
    .card { display: flex; flex-direction: column; border-radius: 18px; overflow: hidden; background: var(--cream-card);
      border: 1px solid rgba(51,51,51,.1); box-shadow: 0 20px 44px -30px rgba(90,48,28,.5); text-decoration: none; color: inherit;
      transition: transform .16s ease, box-shadow .16s ease; }
    .card:hover { transform: translateY(-3px); box-shadow: 0 28px 56px -30px rgba(90,48,28,.6); }
    .swatch { height: 96px; display: flex; align-items: flex-end; padding: .7rem .9rem; position: relative; }
    .swatch b { font-weight: 900; font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; color: #fff; background: rgba(0,0,0,.28); padding: .25rem .55rem; border-radius: 999px; }
    .sw-ladrillo { background: #9e4430; }
    .sw-terracota { background: radial-gradient(120% 120% at 84% -12%, #c65a3d, #8c3724 78%); }
    .sw-crema { background: radial-gradient(120% 120% at 80% -10%, #efe8d7, #e6dcc2); }
    .sw-crema b, .sw-panel b { color: #4a2318; background: rgba(255,255,255,.5); }
    .sw-panel { background: linear-gradient(105deg, #a8452e 0 52%, #e6dcc2 52% 100%); }
    .card__body { padding: 1rem 1.1rem 1.15rem; display: flex; flex-direction: column; gap: .3rem; flex: 1; }
