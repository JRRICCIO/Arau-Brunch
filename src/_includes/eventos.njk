        <!-- Próximo evento (editable/ocultable desde el panel) -->
        {%- if eventos.proximo and eventos.proximo.activo %}
        <article class="event-feature event-feature--boxed event-feature--next reveal{% if not eventos.proximo.foto %} event-feature--no-photo{% endif %}">
          {%- if eventos.proximo.foto %}
          <div class="event-feature__media">
            <button type="button" class="event-feature__photo thumb" data-gallery="evento-proximo"
                    data-full="{{ eventos.proximo.foto | asset }}" data-caption="{{ eventos.proximo.titulo }}">
              <img src="{{ eventos.proximo.foto | asset }}" alt="{{ eventos.proximo.fotoAlt }}" width="760" height="560" loading="lazy" decoding="async" />
              <span class="event-feature__play" aria-hidden="true">{{ ui.eventos.feature.play }}</span>
            </button>
          </div>
          {%- endif %}
          <div class="event-feature__body">
            <p class="event__kicker">{{ eventos.proximo.kicker }}</p>
            <h3 class="event-feature__title">{{ eventos.proximo.titulo }}</h3>
            {%- if eventos.proximo.fecha %}<span class="event__chip">{{ eventos.proximo.fecha }}</span>{%- endif %}
            <p class="event-feature__desc">{{ eventos.proximo.desc }}</p>
            <div class="event__actions">
              <button type="button" class="btn btn--terra js-inscribirme" data-evento-id="{{ eventos.proximo.id }}" data-evento-nombre="{{ eventos.proximo.titulo }}">{{ eventos.proximo.cta }}</button>
            </div>
          </div>
        </article>
        {%- endif %}

        <!-- Destacado: Bingo (con recuadro) -->
        {%- if eventos.feature.activo != false %}
        <article class="event-feature event-feature--boxed event-feature--no-photo reveal">
          <div class="event-feature__body">
            <p class="event__kicker">{{ eventos.feature.kicker }}</p>
            <h3 class="event-feature__title">{{ eventos.feature.titleStart }} <span class="ital">{{ eventos.feature.titleAccent }}</span></h3>
            {%- if eventos.feature.fechas %}
            <div class="event__dates">
              {%- for f in eventos.feature.fechas %}
              <span class="event__chip{% if f.agotado %} event__chip--soldout{% elif f.nueva %} event__chip--nueva{% endif %}">{{ f.fecha }}{% if f.agotado %} <span class="soldout-tag">{{ ui.eventos.agotado }}</span>{% elif f.nueva %} <span class="nueva-tag">{{ ui.eventos.nueva }}</span>{% endif %}</span>
              {%- endfor %}
            </div>
            {%- elif eventos.feature.chip %}
            <span class="event__chip">{{ eventos.feature.chip }}</span>
            {%- endif %}
            {%- if eventos.feature.premios or eventos.feature.intro or eventos.feature.especial %}
            <div class="bingo-copy">
              {%- if eventos.feature.intro %}<p class="bingo-copy__intro">{{ eventos.feature.intro }}</p>{%- endif %}
              {%- if eventos.feature.premios %}
              <div class="bingo-prizes">
                <p class="bingo-prizes__head"><span class="bingo-prizes__ic" aria-hidden="true">🏆</span> {{ ui.eventos.feature.premios }}{% if eventos.feature.premiosNota %} <span class="bingo-prizes__note">· {{ eventos.feature.premiosNota }}</span>{% endif %}</p>
                <ul class="bingo-prizes__list">
                  {%- for p in eventos.feature.premios %}
                  <li class="bingo-prizes__row">
                    <span class="bingo-prizes__ronda">{{ p.ronda }}</span>
                    <span class="bingo-prizes__arrow" aria-hidden="true">→</span>
                    <span class="bingo-prizes__win">{{ p.premio }}</span>
                  </li>
                  {%- endfor %}
                </ul>
              </div>
              {%- endif %}
              {%- if eventos.feature.especial %}
              <p class="bingo-special"><span class="bingo-special__tag">{{ ui.eventos.feature.especialLabel }}</span> <span class="bingo-special__txt">{{ eventos.feature.especial }}</span></p>
              {%- endif %}
            </div>
            {%- elif eventos.feature.desc %}
            <p class="event-feature__desc">{{ eventos.feature.desc }}</p>
            {%- endif %}
            <div class="event__actions">
              {%- if eventos.feature.lumaUrl %}
              <a class="btn btn--terra js-bingo-balls" id="arau-bingo-btn" href="{{ eventos.feature.lumaUrl }}" target="_blank" rel="noopener noreferrer">{{ ui.eventos.feature.inscribirse }}</a>
              {%- elif eventos.feature.inscripciones %}
              <button type="button" class="btn btn--terra js-inscribirme" data-evento-id="{{ eventos.feature.id }}" data-evento-nombre="{{ eventos.feature.kicker }}">{{ ui.inscripcion.cta }}</button>
              {%- endif %}
              {%- set igHref = eventos.feature.igReelsUrl if eventos.feature.igReelsUrl else "https://instagram.com/" + site.contacto.instagram %}
              {%- set igText = ui.eventos.feature.verReelsIg if eventos.feature.igReelsUrl else ui.eventos.feature.verFotosIg %}
              <a class="inline-link" href="{{ igHref }}" target="_blank" rel="noopener noreferrer">{{ igText }}</a>
            </div>
          </div>
        </article>
        {%- endif %}

        <!-- Otros eventos en Arau -->
        {%- set otrosActivos = eventos.otros.items | selectattr("activo") | list %}
        {%- if otrosActivos | length %}
        <div class="events-more reveal">
          <h3 class="events-more__title">{{ eventos.otros.heading }}</h3>
          <p class="events-more__sub">{{ eventos.otros.sub }}</p>
          <ul class="events-more__list">
            {%- for it in otrosActivos %}
            <li class="events-more__item{% if it.foto %} events-more__item--haspic{% endif %}">
              {%- if it.foto %}
              <button type="button" class="events-more__thumb thumb" data-gallery="evento-otros" data-full="{{ it.foto | asset }}" data-caption="{{ it.title }}">
                <img src="{{ it.foto | asset }}" alt="{{ it.fotoAlt }}" width="320" height="180" loading="lazy" decoding="async" />
              </button>
              {%- endif %}
              <h4 class="events-more__name">{{ it.title }}</h4>
              <p class="events-more__desc">{{ it.desc }}</p>
            </li>
            {%- endfor %}
          </ul>
          <button type="button" class="btn btn--terra js-inscribirme" data-evento-id="otros-eventos" data-evento-nombre="{{ eventos.otros.heading }}">{{ eventos.otros.cta }}</button>
        </div>
        {%- endif %}
