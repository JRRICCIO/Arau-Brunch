{#- Tipografía y tamaño configurables desde el panel (src/_data/tema.json).
    Sobrescribe las variables CSS DESPUÉS de styles.css, así que gana el tema. -#}
{%- set fs = "1" -%}
{%- if tema.tamano == "chico" %}{% set fs = "0.94" %}{% elif tema.tamano == "grande" %}{% set fs = "1.08" %}{% endif -%}
<style id="tema-vars">
  :root { --fs-scale: {{ fs }}; }
  html { font-size: calc(100% * var(--fs-scale)); }
{%- if tema.tipografia == "editorial" %}
  :root { --font-display: Georgia, "Iowan Old Style", "Palatino Linotype", "Times New Roman", serif; }
{%- elif tema.tipografia == "redonda" %}
  :root {
    --font-display: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --font-body: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }
{%- endif %}
</style>
